{
  "name": "bionic-code-reader",
  "displayName": "Bionic Code Reader",
  "description": "Configurable Bionic-style emphasis for source code, with an independently testable reading algorithm.",
  "version": "0.2.0",
  "publisher": "cody-webb",
  "repository": {
    "type": "git",
    "url": "https://github.com/cody3629/Bionic-Reader-VSCode-Extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bionicCodeReader.toggle",
        "title": "Bionic Code Reader: Toggle On/Off"
      },
      {
        "command": "bionicCodeReader.increaseStrength",
        "title": "Bionic Code Reader: Increase Fixation Strength (5%)"
      },
      {
        "command": "bionicCodeReader.decreaseStrength",
        "title": "Bionic Code Reader: Decrease Fixation Strength (5%)"
      },
      {
        "command": "bionicCodeReader.increaseMinimumWordLength",
        "title": "Bionic Code Reader: Increase Minimum Word Length (+1)"
      },
      {
        "command": "bionicCodeReader.decreaseMinimumWordLength",
        "title": "Bionic Code Reader: Decrease Minimum Word Length (-1)"
      },
      {
        "command": "bionicCodeReader.increaseSaccades",
        "title": "Bionic Code Reader: Increase Saccades (+1)"
      },
      {
        "command": "bionicCodeReader.decreaseSaccades",
        "title": "Bionic Code Reader: Decrease Saccades (-1)"
      },
      {
        "command": "bionicCodeReader.toggleSaccades",
        "title": "Bionic Code Reader: Toggle Saccades (0/1)"
      },
      {
        "command": "bionicCodeReader.increaseDelay",
        "title": "Bionic Code Reader: Increase Update Delay (+10ms)"
      },
      {
        "command": "bionicCodeReader.decreaseDelay",
        "title": "Bionic Code Reader: Decrease Update Delay (-10ms)"
      }
    ],
    "keybindings": [
      {
        "command": "bionicCodeReader.toggle",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ],
    "configuration": {
      "title": "Bionic Code Reader",
      "properties": {
        "bionicCodeReader.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Apply Bionic-style emphasis in supported text editors."
        },
        "bionicCodeReader.fixationStrength": {
          "type": "number",
          "default": 0.35,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Fraction of each eligible word emphasized, rounded up."
        },
        "bionicCodeReader.saccades": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of eligible words skipped after each emphasized word. 0 emphasizes every eligible word."
        },
        "bionicCodeReader.minimumWordLength": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 20,
          "description": "Words shorter than this length are left unformatted and do not count toward saccades."
        },
        "bionicCodeReader.fontWeight": {
          "type": "string",
          "default": "600",
          "enum": [
            "400",
            "500",
            "600",
            "700",
            "800",
            "900"
          ],
          "description": "Font weight for emphasized characters. This does not change editor.fontWeight."
        },
        "bionicCodeReader.excludedLanguages": {
          "type": "array",
          "default": [
            "log"
          ],
          "items": {
            "type": "string"
          },
          "description": "Language IDs that should not receive Bionic formatting."
        },
        "bionicCodeReader.updateDelay": {
          "type": "integer",
          "default": 120,
          "minimum": 0,
          "maximum": 1000,
          "description": "Debounce delay in milliseconds after editing."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/reading-engine.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "vsce package"
  },
  "license": "MIT",
  "devDependencies": {
    "@vscode/vsce": "^4.1.0",
    "jest": "^30.5.2"
  }
}
